# KODM Monitör ortam değişkenleri — bu dosyayı `.env` olarak kopyalayıp doldurun.
# Portainer'da Stack kurarken bu değerleri "Environment variables" bölümüne de girebilirsiniz.
# ÖNEMLİ: gerçek şifreleri git'e/commit'e koymayın, `.env` dosyası yereldedir.

PORT=4000
SUBNET=192.168.41

# Tenda AP (kablolu/kablosuz ayrımı için)
AP_IP=192.168.41.210
AP_PASS=

# Zyxel modem (istemci listesi + WAN hattı için)
MODEM_IP=192.168.41.1
MODEM_USER=admin
MODEM_PASS=

# server2 Windows ajanı
SERVER2_URL=http://192.168.41.252:9419/smb

# Hedef Linux ise sistem yükü için (Windows hedefte gerekmez):
# SSH_USER=
# SSH_PASS=
# SSH_KEY_PATH=
